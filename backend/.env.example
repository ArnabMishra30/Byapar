# Copy this file to .env and fill in real values. Never commit .env.

# --- server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000

# --- database -------------------------------------------------------------
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:your-password@localhost:5432/pharma_erp?schema=public"

# --- authentication -------------------------------------------------------
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=1d

# --- admin seed (used only by: npm run prisma:seed) -----------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-seeding
ADMIN_NAME=Administrator
ADMIN_COMPANY_NAME=Default Company

# --- misc -----------------------------------------------------------------
# "*" allows any origin. In production list them: https://app.example.com,https://admin.example.com
CORS_ORIGIN=*
LOG_LEVEL=info

# --- database transactions -------------------------------------------------
# How long one transaction may take. Prisma defaults to 2s/5s, which assumes a
# database on the same machine. A managed database in another region, or one
# waking from idle, needs more: posting a document is dozens of round trips.
DB_TRANSACTION_MAX_WAIT_MS=10000
DB_TRANSACTION_TIMEOUT_MS=20000

# --- AI bill import -------------------------------------------------------
# ALL OPTIONAL. Leave them blank and every other feature works exactly as
# before; bill upload simply reports that automatic reading is not set up and
# the shop types the bill in by hand.
#
# LLAMA_API_KEY IS A SERVER SECRET (a LlamaCloud key, starting "llx-"). It is
# read by the backend, used only when calling the reader, and never sent to a
# browser. Do NOT copy it into any
# NEXT_PUBLIC_* variable in either frontend - anything with that prefix is
# compiled into JavaScript that every visitor can read. Do not commit the real
# key.
LLAMA_API_KEY=
# LlamaCloud API base. Leave as is unless the vendor changes it.
LLAMA_BASE_URL=https://api.cloud.llamaindex.ai
# LlamaExtract tier: fast | cost_effective | agentic | agentic_plus.
# Higher tiers cost more credits per bill and read harder documents better.
LLAMA_EXTRACT_TIER=cost_effective
# Only needed if your LlamaCloud account has more than one project.
LLAMA_PROJECT_ID=
# Budget for one whole read: upload, job and polling together.
LLAMA_TIMEOUT_MS=90000

# Where uploaded bill images and PDFs are written. Put this OUTSIDE the repo in
# any real deployment, on a disk that is backed up.
BILL_STORAGE_DIR=./storage/bills
# Largest bill accepted, in bytes. Default 10 MB.
BILL_MAX_FILE_SIZE=10485760

# --- platform superadmin (used only by: npm run seed:platform) -------------
# The person who runs the SaaS platform, as opposed to a shop.
#
# This account has role PLATFORM_ADMIN and NO company, which is exactly what
# keeps it out of every shop's books. Keep it separate from ADMIN_EMAIL above:
# a shop admin who could also administer the platform would be able to reach
# every other shop's account.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=Platform Administrator
