# Copy to .env.test. Used only by "npm run test".
# Point this at a SEPARATE database: the test suite deletes rows before each run.

NODE_ENV=test
DATABASE_URL="postgresql://postgres:your-password@localhost:5432/pharma_erp_test?schema=public"

JWT_SECRET=test-secret-value-that-is-at-least-32-characters-long
JWT_EXPIRES_IN=1d

ADMIN_EMAIL=admin@test.local
ADMIN_PASSWORD=test-admin-password
ADMIN_NAME=Test Admin
ADMIN_COMPANY_NAME=Test Company

LOG_LEVEL=error
