# Platform Admin Panel environment variables.
#
# Never put a secret here (AI key, database URL, JWT secret) - those live only
# on the backend.
#
# Read at BUILD time: on Render, set it in the service's Environment tab, and
# redeploy after changing it.

# The Express backend, including /api/v1. The browser calls /api/v1 on this
# site and Next.js proxies it there, keeping the session cookies first-party.
#   Local:      http://localhost:4000/api/v1 (the default when unset)
#   Production: https://<your-backend>.onrender.com/api/v1
# NEXT_PUBLIC_API_URL is still accepted.
API_URL=http://localhost:4000/api/v1
