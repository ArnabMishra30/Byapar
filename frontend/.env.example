# Platform Admin Panel environment variables.
#
# NEXT_PUBLIC_ variables are COMPILED INTO THE BROWSER BUNDLE and anyone can
# read them. Never put a secret here (AI key, database URL, JWT secret) - those
# live only on the backend.
#
# Read at BUILD time: on Render, set it in the service's Environment tab, and
# redeploy after changing it.

# The Express backend, including /api/v1.
#   Local:      http://localhost:4000/api/v1
#   Production: https://<your-backend>.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
