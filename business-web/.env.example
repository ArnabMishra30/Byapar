# Business Web environment variables.
#
# NEXT_PUBLIC_ variables are COMPILED INTO THE BROWSER BUNDLE and anyone can
# read them. Never put a secret (AI key, database URL, JWT secret) in this file,
# in a NEXT_PUBLIC_* variable, or in GitHub. Those live only on the backend.
#
# Values are read at BUILD time. On Render, set them in the service's
# Environment tab; after changing one, redeploy.

# The Express backend, including /api/v1. The browser never calls it directly:
# it calls /api/v1 on this site, and Next.js proxies the request there, which
# keeps the httpOnly session cookies first-party.
#   Local:      http://localhost:4000/api/v1 (the default when unset)
#   Production: https://<your-backend>.onrender.com/api/v1
# Not needed for the landing page (pricing falls back to the configured list).
# Required for login and the shop app. NEXT_PUBLIC_API_URL is still accepted.
API_URL=http://localhost:4000/api/v1

# Optional public contact details for the pricing, FAQ and get-started
# sections. Leave empty to hide the contact buttons.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
